# Local values only. Never commit a real secret.
# NestJS reads DATABASE_URL. Python reads AI_DATABASE_URL.
# There is no foreign key between schema app and schema analytics.

DATABASE_URL=postgresql://shawaf_app:shawaf_app@localhost:5432/shawaf?schema=app
AI_DATABASE_URL=postgresql://shawaf_ai:shawaf_ai@localhost:5432/shawaf

NEST_TO_AI_HMAC_SECRET=local-nest-to-ai
AI_TO_NEST_HMAC_SECRET=local-ai-to-nest

S3_BUCKET=shawaf-media
PLAYBACK_PAD_MS=2000
PACKAGE_MODE=unconnected
